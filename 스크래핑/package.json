    "stock:watch": "tsx src/cli.ts watch",
    "autostart": "tsx src/cli.ts autostart",
    "manage": "tsx src/cli.ts manage",
    "disclose": "tsx src/cli.ts disclose",
    "intake": "tsx src/cli.ts intake"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.6",
    "typescript": "^5",
