{
  "name": "ricky-sourcing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RICKY 소싱 리서치 파이프라인 — 한국 인기도 신호 × 캐나다 공식몰 신제품 × CA/KR 가격 비교",
  "scripts": {
    "scan": "tsx src/cli.ts scan",
    "signals": "tsx src/cli.ts signals",
    "catalog": "tsx src/cli.ts catalog",
    "compare": "tsx src/cli.ts compare",
    "doctor": "tsx src/cli.ts doctor",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "browsers": "playwright install chromium",
