# ---------------------------------------------------------------------------
# 네이버 검색 / 검색어트렌드 API
#
# 2026년에 네이버가 검색·데이터랩 API 를 개발자센터에서 NAVER API HUB
# (네이버 클라우드 플랫폼)로 이관했다. 그래서 developers.naver.com 의
# "사용 API" 드롭다운에는 검색·데이터랩이 더 이상 보이지 않는다.
#
#   [신규 발급 — 이쪽을 쓴다]
#   https://www.ncloud.com/product/applicationService/naverApiHub
#   콘솔에서 검색 API + Search Trend 를 신청하고 인증키를 발급받는다.
# ---------------------------------------------------------------------------
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=

# ---------------------------------------------------------------------------
# (구) developers.naver.com 키 — 2027-06-30 까지만 유예된다.
# 기존에 발급받아 둔 키가 있으면 이걸 채워도 동작한다. 없으면 비워 둔다.
# ---------------------------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 참고: 네이버 쇼핑 검색 API 는 2026-07-31 종료됐고 대체가 없다.
#       국내 가격 비교는 브랜드 한국 공식몰 정가를 기준으로 한다.

# ---------------------------------------------------------------------------
# 환율 — 미설정 시 exchangerate.host 공개 API 사용(무키)
#   관세 안내용 고시환율과 원가 계산용 시장환율을 분리한다 (CLAUDE.md 규칙 7)
# ---------------------------------------------------------------------------
FX_CAD_KRW=            # 수동 고정값 (비우면 자동 조회)
FX_USD_KRW=

# ---------------------------------------------------------------------------
# 크롤러 정중함 설정 (CLAUDE.md 규칙 8)
# ---------------------------------------------------------------------------
CRAWL_DELAY_MS=2500    # 같은 호스트 요청 간 최소 지연. 429 가 잦으면 더 올려라
CRAWL_CONCURRENCY=2    # 호스트당 동시 요청 수
CRAWL_MAX_RETRY=3
CACHE_TTL_MIN=360      # HTTP 캐시 수명(분). 재실행 시 재요청 억제
