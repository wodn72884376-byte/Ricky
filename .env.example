# 로컬 개발용. 실제 값은 커밋하지 않는다(.env*는 gitignore 대상).
# 배포 환경에서는 호스팅 UI의 환경변수에 같은 키를 넣는다.
#
# 이 값들이 없어도 **빌드는 통과하고 스토어 화면은 뜬다**.
# 동작하지 않는 것: 로그인, 주문, /admin
#
# ---------------------------------------------------------------------------
# Supabase — 프로젝트 대시보드 > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키는 RLS를 우회한다. 서버 전용이며 절대 클라이언트에 노출하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe 키는 없다 — 결제는 스마트스토어에서 일어난다.
# 자체 결제로 돌아오면 src/lib/env.ts 의 serverSchema 와 함께 되살린다.

# ---------------------------------------------------------------------------
# 사이트
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
